# ==============================================================================
# GCSPreWarm Configuration
# ==============================================================================

# Target GCS bucket name (Required)
GCS_BUCKET_NAME=my-target-bucket

# Google Cloud Project ID (Optional)
GCP_PROJECT_ID=

# ==============================================================================
# Target QPS Configuration
# ==============================================================================
# Set to 0 if only write or only read is desired.
TARGET_READ_QPS=0
TARGET_WRITE_QPS=10000

# Ramp Profile Preset:
#   - AUTO: (Recommended) Automatically sizes ramp duration based on QPS tier (e.g. 3m for 10k, 5m for 30k)
#   - FAST: Fast turbo ramp (~60s per doubling step, ideal for rapid testing & low error rates)
#   - STANDARD: Standard ramp (~100s per doubling step)
#   - CONSERVATIVE: Ultra-conservative 20-minute enterprise ramp
#   - CUSTOM: Uses explicit RAMP_DURATION_SECONDS
RAMP_PROFILE=AUTO

# Explicit ramp-up duration in seconds (used when RAMP_PROFILE=CUSTOM or via CLI --ramp-duration)
RAMP_DURATION_SECONDS=1200

# Duration in seconds to sustain the target QPS after ramp-up is complete
SUSTAIN_DURATION_SECONDS=120

# Payload size in bytes for dummy test objects (default 4KB)
OBJECT_SIZE_BYTES=4096

# ==============================================================================
# Partition & Prefix Sharding Configuration
# ==============================================================================
# Key strategy: HEX (default), ALPHANUMERIC, or CUSTOM
KEY_STRATEGY=HEX

# Prefix strategy: AUTO (auto-calculated from target QPS), HEX_1, HEX_2, HEX_3
PREFIX_STRATEGY=AUTO

# Custom comma-separated prefixes (used when KEY_STRATEGY=CUSTOM)
# e.g., users/,orders/,media/,events/,logs/
CUSTOM_PREFIXES=

# Custom prefix template sequence (used when KEY_STRATEGY=CUSTOM)
# e.g., tenant_{001..050}/
PREFIX_TEMPLATE=

# Base folder path inside the bucket (e.g. gcs_prewarm_test/ or leave empty for bucket root)
KEY_PREFIX_BASE=gcs_prewarm_test/

# ==============================================================================
# Post-Run Lifecycle & Cleanup
# ==============================================================================
# Delete created test objects when test finishes (true/false)
CLEANUP_ON_FINISH=true

# Rotating write key pool size per shard (default 256 keys/shard, e.g. 00-ff in HEX mode).
# Overwriting rotating keys triggers 100% full GCS write load & partition splitting
# while capping total objects to ~4,096, allowing instantaneous (<1-2s) post-test cleanup.
# Set to 0 for infinite unique timestamped keys.
WRITE_KEY_POOL_SIZE=256

# Keep-warm mode: maintain low-rate heartbeat traffic after test ends to sustain splits (true/false)
KEEP_WARM_MODE=false

# ==============================================================================
# Optional Engine Tuning Overrides (Defaults are 100% dynamically auto-calculated)
# ==============================================================================
# WORKER_POOL_SIZE=100
# HTTP_MAX_CONNECTIONS=500
# SEED_OBJECTS_PER_PREFIX=50
# NUM_WORKERS=8
